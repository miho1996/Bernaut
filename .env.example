# RPC Robinhood Chain (chain id 4663). Обязательно — без него сайт покажет демо-данные.
RPC_URL=

# Ключ Anthropic для AI-обзора (console.anthropic.com). Без него — алгоритмический обзор.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5-5

# Индексатор
BACKFILL_HOURS=6        # сколько часов истории догонять при старте
POLL_MS=3000            # как часто проверять новые блоки
REFRESH_MS=20000        # как часто обновлять graduationStatus и ликвидность
LOG_CHUNK=2000          # блоков на один getLogs (уменьшится сам, если RPC ругается)
SNIPER_BLOCKS=20        # покупки в первые N блоков после запуска считаются снайперскими
DEAD_AFTER_MIN=120      # выкидывать мёртвые токены без сделок дольше N минут (если прогресс < 10%)
MAX_TRACKED=4000
LIST_LIMIT=500
# PAIR_USD={"0xадрес_пар_токена":1.0}   # ручная цена пар-токена, если его нет в ETH/BTC/USD
# ETH_USD=3000                          # запасная цена ETH, если CoinGecko недоступен

# API
REVIEW_CACHE_SEC=300
REVIEW_RATE_PER_MIN=6
CORS_ORIGIN=*
